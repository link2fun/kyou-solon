<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.noear</groupId>
    <artifactId>solon-parent</artifactId>
    <version>4.0.5</version>
    <relativePath/>
  </parent>

  <groupId>com.github.link2fun</groupId>
  <artifactId>kyou-solon</artifactId>
  <version>0.0.1</version>

  <packaging>pom</packaging>

  <description>Solon + EasyQuery + Tlog 脚手架</description>
  <modules>
    <module>kyou-support</module>
    <module>kyou-system</module>
    <module>kyou-schedule</module>
    <module>kyou-gen-plugin</module>
    <module>kyou-main</module>
    <module>kyou-tlog-solon-plugin</module>
    <module>kyou-biz</module>
  </modules>

  <properties>
    <kyou.version>0.0.1</kyou.version>
    <java.version>17</java.version>
    <jackson.version>2.21.4</jackson.version>
    <mysql.connector.version>26.7.0</mysql.connector.version>
    <sa-token.version>1.45.0</sa-token.version>
    <poi.version>5.5.1</poi.version>
    <easy-query.version>3.2.15</easy-query.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--        打包跳过单元测试-->
    <skipTests>true</skipTests>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Mysql驱动包 -->
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>${mysql.connector.version}</version>
      </dependency>

      <!-- sa-token solon 插件 -->
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-solon-plugin</artifactId>
        <version>${sa-token.version}</version>
      </dependency>

      <!-- 结合 redisson 实现 SaTokenDao -->
      <!-- https://mvnrepository.com/artifact/cn.dev33/sa-token-redisson -->
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-redisson</artifactId>
        <version>${sa-token.version}</version>
      </dependency>

      <!-- sa-token JSON 序列化支持 (SaJsonTemplate 实现) -->
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-jackson</artifactId>
        <version>${sa-token.version}</version>
      </dependency>

      <!-- sa-token-redisson 传递的 redisson 与 solon 生态版本不一致，统一跟随 solon-parent 管理的版本 -->
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson</artifactId>
        <version>${redisson.version}</version>
      </dependency>

      <!-- hutool工具 -->
      <dependency>
        <groupId>cn.hutool</groupId>
        <artifactId>hutool-bom</artifactId>
        <version>${hutool.version}</version>
        <type>pom</type>
        <!-- 注意这里是import -->
        <scope>import</scope>
      </dependency>
      <!-- Apache POI -->
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>${poi.version}</version>
      </dependency>

      <dependency>
        <groupId>cn.idev.excel</groupId>
        <artifactId>fastexcel</artifactId>
        <version>1.3.0</version>
      </dependency>


      <!-- 通用模块 -->
      <dependency>
        <groupId>com.github.link2fun</groupId>
        <artifactId>kyou-support</artifactId>
        <version>${kyou.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.link2fun</groupId>
        <artifactId>kyou-tlog-solon-plugin</artifactId>
        <version>${kyou.version}</version>
      </dependency>

      <!-- Jackson BOM 统一管理全家族版本（annotations/core/databind/yaml/jsr310 等），
           避免单独钉 core/databind 时 annotations 仍跟随 solon-parent 导致版本错位 -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 代码生成 -->
      <dependency>
        <groupId>com.github.link2fun</groupId>
        <artifactId>kyou-gen-plugin</artifactId>
        <version>${kyou.version}</version>
      </dependency>
      <!-- 任务调度 -->
      <dependency>
        <groupId>com.github.link2fun</groupId>
        <artifactId>kyou-schedule</artifactId>
        <version>${kyou.version}</version>
      </dependency>
      <!-- 系统模块 -->
      <dependency>
        <groupId>com.github.link2fun</groupId>
        <artifactId>kyou-system</artifactId>
        <version>${kyou.version}</version>
      </dependency>

      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-api</artifactId>
        <version>2.26.1</version>
        <scope>compile</scope>
      </dependency>

      <!-- https://mvnrepository.com/artifact/net.bytebuddy/byte-buddy -->
      <dependency>
        <groupId>net.bytebuddy</groupId>
        <artifactId>byte-buddy</artifactId>
        <version>1.18.11</version>
      </dependency>

    </dependencies>
  </dependencyManagement>


  <build>


    <resources>
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.xml</include>
        </includes>
        <filtering>false</filtering>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>**</include>
        </includes>
      </resource>

    </resources>
  </build>
</project>